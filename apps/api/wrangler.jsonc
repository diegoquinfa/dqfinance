{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dqfinance-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-18",
  // Better Auth relies on AsyncLocalStorage and node:crypto.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    // Public origin of this worker. It is the OAuth issuer and the base of the MCP resource URL.
    "BETTER_AUTH_URL": "http://localhost:8787",
    // Origin of apps/web. It hosts the sign-in and consent pages and is the only CORS origin.
    "WEB_URL": "http://localhost:3000"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dqfinance",
      // Replace with the id printed by `wrangler d1 create dqfinance` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Documents per source. Local dev uses miniflare's local R2; create the bucket before deploying.
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "dqfinance-documents"
    }
  ],
  "observability": {
    "enabled": true
  },
  // Declared so `cf-typegen` is deterministic without a local .dev.vars. VAPID keys stay optional
  // (see src/app-env.ts): absent means push notifications are off.
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"]
  }
  // Secrets (set with `wrangler secret put`, or in .dev.vars locally): BETTER_AUTH_SECRET
}
